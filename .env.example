# Copiez ce fichier vers .env puis adaptez les valeurs. Ne commitez jamais .env.

# --- Base de données (Docker Compose) ---
POSTGRES_USER=prospect
# Choisissez un mot de passe long et aléatoire, et reportez-le dans les deux URL ci-dessous.
POSTGRES_PASSWORD=remplacez-moi
POSTGRES_DB=prospect
# Ports publiés sur votre machine seulement (127.0.0.1) ; 5432 est souvent déjà pris.
# Les URL de connexion utilisent 127.0.0.1 : sous Windows, « localhost » essaie d'abord IPv6 et perd ~10 s.
DB_PORT=5433
API_PORT=8000
WEB_PORT=5173

# --- Backend lancé hors Docker (tests, migrations) ---
DATABASE_URL=postgresql+psycopg://prospect:remplacez-moi@127.0.0.1:5433/prospect
# Base dédiée aux tests, créée automatiquement par la suite de tests.
TEST_DATABASE_URL=postgresql+psycopg://prospect:remplacez-moi@127.0.0.1:5433/prospect_test

# --- Votre position (bonus de proximité dans la priorité de contact) ---
# Latitude et longitude en degrés décimaux, par exemple 45.7640 et 4.8357.
HOME_LAT=
HOME_LONG=

# --- Clé PageSpeed Insights (facultative ; sans clé, la vitesse mobile n'est pas mesurée) ---
PAGESPEED_API_KEY=

# --- Brouillons d'approche (V2) ---
# Votre identité, reprise dans chaque brouillon d'e-mail et de script d'appel.
SENDER_NAME=
SENDER_BUSINESS=
# Clé de l'API Claude (facultative) : sans elle, les brouillons utilisent des modèles de texte fixes.
ANTHROPIC_API_KEY=

# --- Offres d'emploi France Travail (facultatif) ---
# Application créée sur francetravail.io et abonnée à « Offres d'emploi v2 ».
# Sans ces deux valeurs, le bonus « recrute sur un poste technique » n'est jamais attribué.
FRANCETRAVAIL_CLIENT_ID=
FRANCETRAVAIL_CLIENT_SECRET=

# --- V3 : fonctions facultatives (true/false) ---
AUDIT_REPORT_ENABLED=true
# Captures d'écran (ordinateur et téléphone) du site dans le rapport.
SCREENSHOTS_ENABLED=true
# Windows hors Docker uniquement : dossier des bibliothèques GTK pour le rapport PDF
# (par exemple celui d'Inkscape). Inutile dans Docker.
WEASYPRINT_DLL_DIRECTORIES=
